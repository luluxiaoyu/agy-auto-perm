{
  "win-auto-perm": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node scripts/session_start.js",
        "timeout": 5
      }
    ],
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/audit_command.js",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
